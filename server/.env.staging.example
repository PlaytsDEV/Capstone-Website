# Production runtime hardening (secure cookies, strict CORS) with an explicit
# staging deployment identity. The write guard distinguishes these values.
NODE_ENV=production
LILYCREST_ENVIRONMENT=staging
STAGING_ALLOW_WRITES=true
QA_RUN_ID=qa-YYYYMMDD-NNN

MONGODB_URI=mongodb+srv://staging-user:replace-me@staging-cluster.example/lilycrest-contract-staging-e2e
DB_NAME=lilycrest-contract-staging-e2e

PUBLIC_API_URL=https://staging-contract-api.example.test
API_PUBLIC_URL=https://staging-contract-api.example.test
PUBLIC_FRONTEND_URL=https://staging-admin.example.test
FRONTEND_URL=https://staging-admin.example.test
EMAIL_ACTION_URL=https://staging-admin.example.test/auth-action
RESERVATION_CONTINUATION_URL=https://staging-admin.example.test/applicant/check-availability
ALLOWED_FRONTEND_ORIGINS=https://staging-admin.example.test
CORS_ORIGINS=https://staging-admin.example.test

FIREBASE_PROJECT_ID=lilycrest-staging-qa
FIREBASE_STORAGE_BUCKET=lilycrest-staging-qa.firebasestorage.app
FIREBASE_CLIENT_EMAIL=replace-with-staging-service-account
FIREBASE_PRIVATE_KEY=replace-with-staging-service-account-key
FIREBASE_PRIVATE_KEY_ID=replace-me
FIREBASE_CLIENT_ID=replace-me
FIREBASE_CLIENT_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/replace-me

PAYMONGO_SECRET_KEY=sk_test_replace_me
PAYMONGO_WEBHOOK_SECRET=whsec_replace_me
RESEND_API_KEY=replace-me
RESEND_FROM_EMAIL=LilyCrest QA <qa@example.test>
MOBILE_OTP_SECRET=replace-with-staging-secret
EMAIL_VERIFICATION_SECRET=replace-with-staging-secret

# Comma-separated allowlist used by the staging notification test route.
STAGING_QA_ADMIN_EMAILS=qa-admin@example.test
