# Copy these values into the deployed backend environment.
# Do not point production CORS/payment redirects at localhost.

NODE_ENV=production
PORT=5000

PUBLIC_FRONTEND_URL=https://www.lilycrest.space
FRONTEND_URL=https://www.lilycrest.space
ALLOWED_FRONTEND_ORIGINS=https://www.lilycrest.space
CORS_ORIGINS=https://www.lilycrest.space
EMAIL_ACTION_URL=https://www.lilycrest.space/auth-action
RESERVATION_CONTINUATION_URL=https://www.lilycrest.space/applicant/check-availability
# Optional when mobile email actions are supported.
MOBILE_DEEP_LINK_URL=

MONGODB_URI=your_production_mongodb_uri

FIREBASE_PROJECT_ID=dormitorymanagement-caps-572cf
FIREBASE_CLIENT_EMAIL=your_firebase_admin_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_WEB_API_KEY=your_firebase_web_api_key
FIREBASE_API_KEY=your_firebase_web_api_key

# Required for durable maintenance attachment storage.
# Without this, /api/attachments stores files on the server filesystem, which is
# only appropriate for local development or a persistent VM disk.
ATTACHMENT_STORAGE_DRIVER=firebase
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
PUBLIC_API_URL=https://api.lilycrest.space

JWT_SECRET=use_a_long_random_secret
SESSION_SECRET=use_a_long_random_secret
EMAIL_OTP_SECRET=use_a_long_random_secret
EMAIL_VERIFICATION_SECRET=use_a_distinct_long_random_secret
PORTAL_SESSION_TTL_HOURS=24

# Resend is the ONLY email provider — every active user-facing email (auth
# and transactional, web and mobile) is delivered through it using a
# published Resend Template. There is no SMTP/Nodemailer fallback.
RESEND_API_KEY=use_a_restricted_resend_api_key
RESEND_FROM_EMAIL=verified_sender_on_your_resend_domain

# Published Resend Template IDs (Resend dashboard -> Templates). Every
# template below is required in production; startupValidation.js fails
# closed if any is missing. See server/services/email/templateRegistry.js.
RESEND_TEMPLATE_EMAIL_VERIFICATION=
RESEND_TEMPLATE_PASSWORD_RESET=
RESEND_TEMPLATE_LOGIN_OTP=
RESEND_TEMPLATE_PASSWORD_CHANGED=
RESEND_TEMPLATE_INQUIRY_RESPONSE=
RESEND_TEMPLATE_RESERVATION_CONFIRMED=
RESEND_TEMPLATE_VISIT_APPROVED=
RESEND_TEMPLATE_VISIT_STATUS=
RESEND_TEMPLATE_DOCUMENTS_REJECTED=
RESEND_TEMPLATE_BILL_GENERATED=
RESEND_TEMPLATE_UTILITY_CHARGE=
RESEND_TEMPLATE_PAYMENT_REMINDER=
RESEND_TEMPLATE_OVERDUE_NOTICE=
RESEND_TEMPLATE_PAYMENT_APPROVED=
RESEND_TEMPLATE_PAYMENT_REJECTED=
RESEND_TEMPLATE_PAYMENT_RECEIPT=

EMAIL_OTP_EXPIRY_MINUTES=10
EMAIL_OTP_RESEND_COOLDOWN_SECONDS=60
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_CONTEXT_TTL_SECONDS=3600
EMAIL_VERIFICATION_SESSION_TTL_SECONDS=900
# Optional — defaults to 60s (bounded 30-3600s) if unset.
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60

PAYMONGO_SECRET_KEY=your_paymongo_secret_key
PAYMONGO_PUBLIC_KEY=your_paymongo_public_key
PAYMONGO_WEBHOOK_SECRET=your_paymongo_webhook_secret

# Optional for the Reports & Analytics AI Insights Hub.
# Use "gemini" for the Gemini-backed hub or "heuristic" for local rule-based insights.
# Gemini has a free tier for small/testing use, but production deployments may need paid tier/quota.
AI_INSIGHTS_PROVIDER=gemini
# Reuse GOOGLE_AI_API_KEY if you already configured Gemini elsewhere.
# GEMINI_API_KEY is also supported and takes precedence when both are set.
GOOGLE_AI_API_KEY=your_google_ai_studio_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Optional for reservation document upload OCR pre-checks.
# No Google Vision or Gemini credentials are required for this feature.
RESERVATION_DOCUMENT_PRECHECK_TIMEOUT_MS=15000
MOBILE_OTP_SECRET=<generate-a-dedicated-random-secret>
ENABLE_MOBILE_SEED=false
# Prospective structured initial-payment workflow. Keep disabled until
# controlled QA and an approved effective time.
STRUCTURED_INITIAL_PAYMENT_ENABLED=false
STRUCTURED_INITIAL_PAYMENT_EFFECTIVE_AT=
