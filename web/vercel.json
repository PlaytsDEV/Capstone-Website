{
  "headers": [
    {
      "source": "/auth-action",
      "headers": [{ "key": "Referrer-Policy", "value": "no-referrer" }]
    },
    {
      "source": "/verify-email",
      "headers": [{ "key": "Referrer-Policy", "value": "no-referrer" }]
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
