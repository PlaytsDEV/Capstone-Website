# Development values. Production deployments must set explicit Lilycrest URLs.
VITE_DEPLOYMENT_ENV=development
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

# Canonical frontend origin embedded in Firebase auth-email links (password
# reset, email verification). Must be set to https://www.lilycrest.space for
# BOTH the Vercel Production and Preview environments — Vite's production
# build mode (import.meta.env.PROD) is the same for either, so a Preview
# deployment without this set would otherwise fail to send reset emails
# rather than leaking its own ephemeral *.vercel.app URL into them.
VITE_APP_URL=http://localhost:5173

VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
