# Copy these values into the Vercel project environment variables.
# Do not point production builds at localhost.

VITE_WEB_BASE_URL=https://YOUR-VERCEL-DOMAIN
VITE_API_URL=https://YOUR-DEPLOYED-BACKEND-DOMAIN/api
VITE_SOCKET_URL=https://YOUR-DEPLOYED-BACKEND-DOMAIN
VITE_SOCKET_TRANSPORTS=polling
# Set VITE_SOCKET_TRANSPORTS=polling,websocket only after WebSocket upgrade is verified for the custom domain.

VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=dormitorymanagement-caps-572cf.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=dormitorymanagement-caps-572cf
VITE_FIREBASE_STORAGE_BUCKET=dormitorymanagement-caps-572cf.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=784085654130
VITE_FIREBASE_APP_ID=your_firebase_web_app_id

